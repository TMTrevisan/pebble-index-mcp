# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env

# --- Required: auth for the Pebble app -> this server -----------------------
# Long random string. Generate: openssl rand -hex 32
# In the Pebble app the Authorization field must be literally "Bearer <token>"
# (the "Bearer " prefix is required — the raw token alone gets 401).
MCP_BEARER_TOKEN=

# --- Required: Home Assistant ----------------------------------------------
# Long-lived access token: HA -> click your profile (bottom-left) ->
# "Long-Lived Access Tokens" -> Create Token. Paste it here.
HASS_TOKEN=
# Usually auto-detected (tries http://homeassistant:8123, then localhost,
# then host.docker.internal). Set explicitly only if detection fails.
#HASS_URL=http://homeassistant:8123

# --- No extra key needed for the `ask` tool ----------------------------------
# `ask` forwards questions to Home Assistant's own conversation agent
# (whatever assistant Todd has configured in HA). No separate API key.

# --- Required for the `wyze` tool (two lights only) -------------------------
# Wyze account credentials. All four are required by the Wyze API.
WYZE_EMAIL=
WYZE_PASSWORD=
WYZE_KEY_ID=
WYZE_API_KEY=
# Device MACs. Defaults are Todd's two authorized lights (verified 2026-10-10);
# override only if the account changes.
#WYZE_TODDS_MAC=D03F27102015
#WYZE_LAMP_MAC=2CAA8E560872

# --- Optional ----------------------------------------------------------------
# Extra Host header values allowed through DNS-rebinding protection,
# comma-separated. Add your public DuckDNS hostname, e.g.:
#MCP_ALLOWED_HOSTS=petitcasa.duckdns.org
# Override the ring persona prompt with a file.
#RING_PERSONA_FILE=
